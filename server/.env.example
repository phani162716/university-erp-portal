PORT=5000
NODE_ENV=development

# Supabase PostgreSQL (Project Settings → Database)
# Transaction pooler (port 6543) — use for the app / Vercel
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) — use for prisma db push / seed / migrate
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Auth
JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="24h"

# CORS — your Vercel URL (comma-separated allowed)
CORS_ORIGIN="http://localhost:5173,https://your-app.vercel.app"

# Used in PDF QR codes
FRONTEND_URL="http://localhost:5173"
