PORT=5000
# SQLite (default, zero-setup local development)
DATABASE_URL="file:./dev.db"

# For PostgreSQL production, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/university_erp?schema=public"
# and set provider = "postgresql" in prisma/schema.prisma

JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="24h"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
